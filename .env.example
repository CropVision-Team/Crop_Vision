# Supabase project settings (Project Settings > API in Supabase dashboard)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Only needed server-side (Edge Functions), NEVER put this in the Flutter app
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# LLM API key for the AI Assistant Edge Function (e.g. Anthropic)
ANTHROPIC_API_KEY=your_api_key_here
